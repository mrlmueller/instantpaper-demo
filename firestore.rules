rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // V2 helper functions (single-user namespace: users/{uid}/...)
    // ---------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null
        && (request.auth.token.fullAccess == true || request.auth.token.approved == true)
        && !isBlocked();
    }

    function isBlocked() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'blocked';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function canViewUsageInsights(userId) {
      return isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.canViewUsageInsights == true;
    }

    function canUseQuellenFinder(userId) {
      return isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.canUseQuellenFinder == true;
    }

    function canUsePdfScan(userId) {
      return isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.canUsePdfScan == true;
    }

    function canReadResearchRun(userId, projectId, runId) {
      return isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId)/researchRuns/$(runId))
        && (
          (
            get(/databases/$(database)/documents/users/$(userId)/projects/$(projectId)/researchRuns/$(runId)).data.kind == 'sources_two_lane'
            && canUseQuellenFinder(userId)
          )
          || (
            get(/databases/$(database)/documents/users/$(userId)/projects/$(projectId)/researchRuns/$(runId)).data.kind == 'pdf_scan'
            && canUsePdfScan(userId)
          )
        );
    }

    function isTs(x) {
      return x is timestamp;
    }

    function isNonEmptyString(s, maxSize) {
      return s is string && s.size() > 0 && s.size() <= maxSize;
    }

    function isString(s, maxSize) {
      return s is string && s.size() <= maxSize;
    }

    function isNullableString(s, maxSize) {
      return s == null || (s is string && s.size() <= maxSize);
    }

    function isValidStage(stage) {
      return stage in ['process_quelle', 'combine', 'shorten', 'lesefluss', 'summary', 'gliederung'];
    }

    function projectExists(userId, projectId) {
      return projectId is string
        && exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));
    }

    function kapitelExists(userId, kapitelId) {
      return kapitelId is string
        && exists(/databases/$(database)/documents/users/$(userId)/kapitels/$(kapitelId));
    }

    function isValidArtifactId(artifactId) {
      return artifactId in ['combined', 'shortened', 'lesefluss'];
    }

    function isValidArchiveState(data) {
      return data.archived is bool
        && (
          (data.archived == false && (!data.keys().hasAny(['archivedAt']) || data.archivedAt == null))
          || (data.archived == true && data.keys().hasAny(['archivedAt']) && isTs(data.archivedAt))
        );
    }

    function isLatestRunMap(x) {
      return x is map
        && x.keys().hasOnly(['runId', 'index', 'status', 'updatedAt'])
        && x.runId is string
        && x.index is int
        && x.status in ['none', 'running', 'done']
        && isTs(x.updatedAt);
    }

    function isUsageMap(u) {
      return u is map
        && u.keys().hasOnly(['inputTokens', 'cachedInputTokens', 'outputTokens', 'reasoningTokens', 'totalTokens'])
        && u.inputTokens is int
        && u.cachedInputTokens is int
        && u.outputTokens is int
        && u.reasoningTokens is int
        && u.totalTokens is int;
    }

    function isRefinementMeta(r) {
      return r is map
        && r.keys().hasOnly(['rootVersionId', 'activeVersionId', 'maxDepth', 'costTotalUsd', 'initializedAt', 'selectedAt'])
        && r.rootVersionId == 'root'
        && r.activeVersionId is string
        && r.maxDepth is int
        && r.costTotalUsd is number
        && isTs(r.initializedAt)
        && (!r.keys().hasAny(['selectedAt']) || r.selectedAt == null || isTs(r.selectedAt));
    }

    function isArtifactsStatusMap(s) {
      return s is map
        && s.keys().hasOnly(['combined', 'shortened', 'lesefluss'])
        && s.combined in ['empty', 'running', 'success', 'error']
        && s.shortened in ['empty', 'running', 'success', 'error']
        && s.lesefluss in ['empty', 'running', 'success', 'error'];
    }

    // ---------------------------------------------------------------------
    // Global server-only config
    // ---------------------------------------------------------------------

    match /_config/{doc=**} {
      allow read, write: if false;
    }

    // System prompt templates contain proprietary prompt text and must never be readable from clients.
    match /systemPromptTemplates/{docId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Users may create their profile doc (server-only fields are not client writable).
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && isNullableString(request.resource.data.email, 320)
        && isNullableString(request.resource.data.displayName, 200)
        && isNullableString(request.resource.data.photoURL, 2000)
        && isTs(request.resource.data.createdAt)
        && isTs(request.resource.data.updatedAt);

      // Users may update their profile, but cannot change server-controlled fields like blocks/billing flags.
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && isNullableString(request.resource.data.email, 320)
        && isNullableString(request.resource.data.displayName, 200)
        && isNullableString(request.resource.data.photoURL, 2000)
        && isTs(request.resource.data.updatedAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);

      allow delete: if isOwner(userId);

      // -------------------------------------------------------------------
      // Server-only collections
      // -------------------------------------------------------------------

      match /secrets/{secretId} {
        allow read, write: if false;
      }

      // Cost metrics are server-written and immutable from the client.
      match /costMetrics/{doc=**} {
        allow read: if canViewUsageInsights(userId);
        allow write: if false;
      }

      // Exports are server-written. Clients may read their own exports only.
      match /exports/{exportId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Credits/billing data is server-written and immutable from the client.
      match /billing/{doc=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /creditLedger/{doc=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // -------------------------------------------------------------------
      // Prompt templates (per-user)
      // -------------------------------------------------------------------

      match /promptTemplates/{templateId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['stage', 'name', 'instructions', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['stage', 'name', 'instructions', 'placeholders', 'createdAt', 'updatedAt'])
          && isValidStage(request.resource.data.stage)
          && isNonEmptyString(request.resource.data.name, 200)
          && isString(request.resource.data.instructions, 50000)
          && isTs(request.resource.data.createdAt)
          && isTs(request.resource.data.updatedAt);

        allow update: if isOwner(userId)
          && request.resource.data.stage == resource.data.stage
          && isValidStage(resource.data.stage)
          && isNonEmptyString(request.resource.data.name, 200)
          && isString(request.resource.data.instructions, 50000)
          && isTs(request.resource.data.updatedAt)
          && request.resource.data.keys().hasOnly(['stage', 'name', 'instructions', 'placeholders', 'createdAt', 'updatedAt'])
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isOwner(userId);
      }

      // Active prompt selections per user (single doc: promptSettings/active)
      match /promptSettings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && settingsId == 'active';
      }

      // -------------------------------------------------------------------
      // Gliederung drafts (per-project outline drafts)
      // -------------------------------------------------------------------

      match /gliederungDrafts/{draftId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'projektId', 'status', 'model', 'promptTemplateId', 'inputs', 'createdAt', 'updatedAt', 'archived'
          ])
          && request.resource.data.keys().hasOnly([
            'projektId',
            'status',
            'errorMessage',
            'model',
            'promptTemplateId',
            'inputs',
            'output',
            'rootId',
            'version',
            'parentDraftId',
            'usage',
            'costUsd',
            'operationId',
            'keySource',
            'appliedAt',
            'appliedKapitelIds',
            'createdAt',
            'updatedAt',
            'archived',
            'archivedAt'
          ])
          && projectExists(userId, request.resource.data.projektId)
          && request.resource.data.status in ['running', 'success', 'error']
          && isNonEmptyString(request.resource.data.model, 100)
          && isNonEmptyString(request.resource.data.promptTemplateId, 200)
          && (!request.resource.data.keys().hasAny(['rootId']) || isNonEmptyString(request.resource.data.rootId, 200))
          && (!request.resource.data.keys().hasAny(['version']) || (request.resource.data.version is int && request.resource.data.version >= 1 && request.resource.data.version <= 999))
          && (!request.resource.data.keys().hasAny(['parentDraftId']) || request.resource.data.parentDraftId == null || isNonEmptyString(request.resource.data.parentDraftId, 200))
          && request.resource.data.inputs is map
          && request.resource.data.inputs.keys().hasAll(['aufgabenstellung', 'gliederungStudienbriefMitSeiten', 'extraKontext'])
          && request.resource.data.inputs.keys().hasOnly(['aufgabenstellung', 'gliederungStudienbriefMitSeiten', 'extraKontext'])
          && isString(request.resource.data.inputs.aufgabenstellung, 50000)
          && isString(request.resource.data.inputs.gliederungStudienbriefMitSeiten, 50000)
          && isString(request.resource.data.inputs.extraKontext, 50000)
          && (!request.resource.data.keys().hasAny(['output']) || request.resource.data.output == null || request.resource.data.output is map)
          && (!request.resource.data.keys().hasAny(['usage']) || request.resource.data.usage is map)
          && (!request.resource.data.keys().hasAny(['costUsd']) || request.resource.data.costUsd is number)
          && (!request.resource.data.keys().hasAny(['errorMessage']) || request.resource.data.errorMessage == null || isString(request.resource.data.errorMessage, 2000))
          && isTs(request.resource.data.createdAt)
          && isTs(request.resource.data.updatedAt)
          && isValidArchiveState(request.resource.data)
          && (!request.resource.data.keys().hasAny(['appliedAt']) || request.resource.data.appliedAt == null || isTs(request.resource.data.appliedAt))
          && (!request.resource.data.keys().hasAny(['appliedKapitelIds']) || request.resource.data.appliedKapitelIds is list);

        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'projektId', 'status', 'model', 'promptTemplateId', 'inputs', 'createdAt', 'updatedAt', 'archived'
          ])
          && request.resource.data.keys().hasOnly([
            'projektId',
            'status',
            'errorMessage',
            'model',
            'promptTemplateId',
            'inputs',
            'output',
            'rootId',
            'version',
            'parentDraftId',
            'usage',
            'costUsd',
            'operationId',
            'keySource',
            'appliedAt',
            'appliedKapitelIds',
            'createdAt',
            'updatedAt',
            'archived',
            'archivedAt'
          ])
          && request.resource.data.projektId == resource.data.projektId
          && request.resource.data.createdAt == resource.data.createdAt
          && projectExists(userId, request.resource.data.projektId)
          && request.resource.data.status in ['running', 'success', 'error']
          && isNonEmptyString(request.resource.data.model, 100)
          && isNonEmptyString(request.resource.data.promptTemplateId, 200)
          && (!request.resource.data.keys().hasAny(['rootId']) || isNonEmptyString(request.resource.data.rootId, 200))
          && (!request.resource.data.keys().hasAny(['version']) || (request.resource.data.version is int && request.resource.data.version >= 1 && request.resource.data.version <= 999))
          && (!request.resource.data.keys().hasAny(['parentDraftId']) || request.resource.data.parentDraftId == null || isNonEmptyString(request.resource.data.parentDraftId, 200))
          && (!request.resource.data.keys().hasAny(['rootId']) || request.resource.data.rootId == resource.data.rootId)
          && (!request.resource.data.keys().hasAny(['version']) || request.resource.data.version == resource.data.version)
          && (!request.resource.data.keys().hasAny(['parentDraftId']) || request.resource.data.parentDraftId == resource.data.parentDraftId)
          && request.resource.data.inputs is map
          && request.resource.data.inputs.keys().hasAll(['aufgabenstellung', 'gliederungStudienbriefMitSeiten', 'extraKontext'])
          && request.resource.data.inputs.keys().hasOnly(['aufgabenstellung', 'gliederungStudienbriefMitSeiten', 'extraKontext'])
          && isString(request.resource.data.inputs.aufgabenstellung, 50000)
          && isString(request.resource.data.inputs.gliederungStudienbriefMitSeiten, 50000)
          && isString(request.resource.data.inputs.extraKontext, 50000)
          && (!request.resource.data.keys().hasAny(['output']) || request.resource.data.output == null || request.resource.data.output is map)
          && (!request.resource.data.keys().hasAny(['usage']) || request.resource.data.usage is map)
          && (!request.resource.data.keys().hasAny(['costUsd']) || request.resource.data.costUsd is number)
          && (!request.resource.data.keys().hasAny(['errorMessage']) || request.resource.data.errorMessage == null || isString(request.resource.data.errorMessage, 2000))
          && isTs(request.resource.data.updatedAt)
          && isValidArchiveState(request.resource.data)
          && (!request.resource.data.keys().hasAny(['appliedAt']) || request.resource.data.appliedAt == null || isTs(request.resource.data.appliedAt))
          && (!request.resource.data.keys().hasAny(['appliedKapitelIds']) || request.resource.data.appliedKapitelIds is list);

        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // projects/{projectId}
      // -------------------------------------------------------------------

      match /projects/{projectId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['name', 'ownerId', 'createdAt', 'updatedAt', 'archived'])
          && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt', 'updatedAt', 'archived', 'archivedAt'])
          && isNonEmptyString(request.resource.data.name, 200)
          && request.resource.data.ownerId == userId
          && isTs(request.resource.data.createdAt)
          && isTs(request.resource.data.updatedAt)
          && isValidArchiveState(request.resource.data);

        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['name', 'ownerId', 'createdAt', 'updatedAt', 'archived'])
          && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt', 'updatedAt', 'archived', 'archivedAt'])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerId == userId
          && request.resource.data.createdAt == resource.data.createdAt
          && isNonEmptyString(request.resource.data.name, 200)
          && isTs(request.resource.data.updatedAt)
          && isValidArchiveState(request.resource.data);

        // Project deletion is an archive transition (client delete denied).
        allow delete: if false;

        // -----------------------------------------------------------------
        // projects/{projectId}/pdfs/{pdfId} (project-level PDF library)
        // -----------------------------------------------------------------

        match /pdfs/{pdfId} {
          allow read: if canUsePdfScan(userId);

          allow create: if canUsePdfScan(userId)
            && projectExists(userId, projectId)
            && request.resource.data.keys().hasAll(['filename', 'storagePath', 'size', 'contentType', 'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['filename', 'storagePath', 'size', 'contentType', 'createdAt', 'updatedAt'])
            && isNonEmptyString(request.resource.data.filename, 500)
            && isNonEmptyString(request.resource.data.storagePath, 1000)
            && request.resource.data.storagePath.matches('^users/' + userId + '/projects/' + projectId + '/pdfs/.+$')
            && request.resource.data.size is int
            && request.resource.data.size >= 0
            && request.resource.data.size <= 60 * 1024 * 1024
            && request.resource.data.contentType == 'application/pdf'
            && isTs(request.resource.data.createdAt)
            && isTs(request.resource.data.updatedAt);

          // PDFs are immutable (replace by deleting + uploading again).
          allow update: if canUsePdfScan(userId)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.storagePath == resource.data.storagePath
            && request.resource.data.size == resource.data.size
            && request.resource.data.contentType == resource.data.contentType
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['filename', 'updatedAt'])
            && isNonEmptyString(request.resource.data.filename, 500)
            && isTs(request.resource.data.updatedAt);

          allow delete: if canUsePdfScan(userId);
        }

        // -----------------------------------------------------------------
        // projects/{projectId}/researchRuns/* (server-owned artifacts)
        // -----------------------------------------------------------------

        match /researchRuns/{runId} {
          allow read: if isOwner(userId)
            && (
              (resource.data.kind == 'sources_two_lane' && canUseQuellenFinder(userId))
              || (resource.data.kind == 'pdf_scan' && canUsePdfScan(userId))
            );
          allow write: if false;

          match /{doc=**} {
            allow read: if canReadResearchRun(userId, projectId, runId);
            allow write: if false;
          }
        }
      }

      // -------------------------------------------------------------------
      // quellen/{quelleId} (metadata) + quellen/{quelleId}/content/main (blob)
      // -------------------------------------------------------------------

      match /quellen/{quelleId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['projektId', 'title', 'createdAt', 'updatedAt', 'archived'])
          && request.resource.data.keys().hasOnly([
            'projektId', 'title', 'createdAt', 'updatedAt', 'archived', 'archivedAt',
            'wordCount', 'images', 'autor', 'jahr', 'typ', 'url', 'zugriffAm', 'zitat', 'zitatModus', 'color'
          ])
          && projectExists(userId, request.resource.data.projektId)
          && isNonEmptyString(request.resource.data.title, 500)
          && isTs(request.resource.data.createdAt)
          && isTs(request.resource.data.updatedAt)
          && isValidArchiveState(request.resource.data)
          && (!request.resource.data.keys().hasAny(['wordCount']) || (request.resource.data.wordCount is int && request.resource.data.wordCount <= 12000));

        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['projektId', 'title', 'createdAt', 'updatedAt', 'archived'])
          && request.resource.data.keys().hasOnly([
            'projektId', 'title', 'createdAt', 'updatedAt', 'archived', 'archivedAt',
            'wordCount', 'images', 'autor', 'jahr', 'typ', 'url', 'zugriffAm', 'zitat', 'zitatModus', 'color'
          ])
          && projectExists(userId, request.resource.data.projektId)
          && isNonEmptyString(request.resource.data.title, 500)
          && request.resource.data.createdAt == resource.data.createdAt
          && isTs(request.resource.data.updatedAt)
          && isValidArchiveState(request.resource.data)
          && (!request.resource.data.keys().hasAny(['wordCount']) || (request.resource.data.wordCount is int && request.resource.data.wordCount <= 12000));

        // Client hard-deletes are denied; use archive fields instead.
        allow delete: if false;

        match /content/{contentId} {
          allow read: if isOwner(userId) && contentId == 'main';

          // Rules cannot count words; enforce true 12000-word limit in app code.
          // Here we enforce a safe character cap + require/stabilize stored wordCount.
          allow create: if isOwner(userId)
            && contentId == 'main'
            && request.resource.data.keys().hasAll(['text', 'wordCount', 'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['text', 'wordCount', 'createdAt', 'updatedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 240000
            && request.resource.data.wordCount is int
            && request.resource.data.wordCount <= 12000
            && isTs(request.resource.data.createdAt)
            && isTs(request.resource.data.updatedAt);

          allow update: if isOwner(userId)
            && contentId == 'main'
            && request.resource.data.keys().hasAll(['text', 'wordCount', 'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['text', 'wordCount', 'createdAt', 'updatedAt'])
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 240000
            && request.resource.data.wordCount is int
            && request.resource.data.wordCount <= 12000
            && isTs(request.resource.data.updatedAt);

          allow delete: if false;
        }
      }

      // -------------------------------------------------------------------
      // kapitels/{kapitelId} + runs/{runId} subtree
      // -------------------------------------------------------------------

      match /kapitels/{kapitelId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'projektId', 'title', 'nummer', 'parentId', 'order', 'quelleIds', 'createdAt', 'updatedAt', 'archived'
          ])
          && request.resource.data.keys().hasOnly([
            'projektId', 'title', 'thema', 'nummer', 'parentId', 'order', 'quelleIds',
            'createdAt', 'updatedAt', 'archived', 'archivedAt', 'latestRun', 'activeRunId'
          ])
          && projectExists(userId, request.resource.data.projektId)
          && isNonEmptyString(request.resource.data.title, 500)
          && (!request.resource.data.keys().hasAny(['thema']) || request.resource.data.thema == null || isString(request.resource.data.thema, 50000))
          && isString(request.resource.data.nummer, 50)
          && (request.resource.data.parentId == null || kapitelExists(userId, request.resource.data.parentId))
          && request.resource.data.order is int
          && request.resource.data.quelleIds is list
          && request.resource.data.quelleIds.size() <= 250
          && isTs(request.resource.data.createdAt)
          && isTs(request.resource.data.updatedAt)
          && isValidArchiveState(request.resource.data)
          && (!request.resource.data.keys().hasAny(['latestRun']) || isLatestRunMap(request.resource.data.latestRun))
          && (!request.resource.data.keys().hasAny(['activeRunId']) || isNonEmptyString(request.resource.data.activeRunId, 200));

        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'projektId', 'title', 'nummer', 'parentId', 'order', 'quelleIds', 'createdAt', 'updatedAt', 'archived'
          ])
          && request.resource.data.keys().hasOnly([
            'projektId', 'title', 'thema', 'nummer', 'parentId', 'order', 'quelleIds',
            'createdAt', 'updatedAt', 'archived', 'archivedAt', 'latestRun', 'activeRunId'
          ])
          && projectExists(userId, request.resource.data.projektId)
          && isNonEmptyString(request.resource.data.title, 500)
          && (!request.resource.data.keys().hasAny(['thema']) || request.resource.data.thema == null || isString(request.resource.data.thema, 50000))
          && isString(request.resource.data.nummer, 50)
          && (request.resource.data.parentId == null || kapitelExists(userId, request.resource.data.parentId))
          && request.resource.data.order is int
          && request.resource.data.quelleIds is list
          && request.resource.data.quelleIds.size() <= 250
          && request.resource.data.createdAt == resource.data.createdAt
          && isTs(request.resource.data.updatedAt)
          && isValidArchiveState(request.resource.data)
          && (!request.resource.data.keys().hasAny(['latestRun']) || isLatestRunMap(request.resource.data.latestRun))
          && (!request.resource.data.keys().hasAny(['activeRunId']) || isNonEmptyString(request.resource.data.activeRunId, 200));

        // Client hard-deletes are denied; use archive fields instead.
        allow delete: if false;

        match /runs/{runId} {
          allow read: if isOwner(userId);

          allow create: if isOwner(userId)
            && request.resource.data.keys().hasAll(['projektId', 'index', 'instruction', 'model', 'createdAt', 'updatedAt', 'archived', 'autoCombine'])
            && request.resource.data.keys().hasOnly([
              'projektId', 'index', 'instruction', 'model', 'provider', 'createdAt', 'updatedAt', 'archived', 'archivedAt',
              'name', 'promptTemplateId', 'promptPayload', 'autoCombine', 'grundlegendeInformationen', 'ueberschrift', 'thema',
              'resultsExpectedCount', 'resultsCompletedCount', 'resultsWithContentCount', 'lastResultAt',
              'artifactsStatus', 'lastActivityAt'
            ])
            && projectExists(userId, request.resource.data.projektId)
            && request.resource.data.index is int
            && isNonEmptyString(request.resource.data.instruction, 50000)
            && (!request.resource.data.keys().hasAny(['name']) || isNonEmptyString(request.resource.data.name, 30))
            && isNonEmptyString(request.resource.data.model, 100)
            && isTs(request.resource.data.createdAt)
            && isTs(request.resource.data.updatedAt)
            && isValidArchiveState(request.resource.data)
            && request.resource.data.autoCombine is bool
            && (!request.resource.data.keys().hasAny(['resultsExpectedCount']) || request.resource.data.resultsExpectedCount is int)
            && (!request.resource.data.keys().hasAny(['resultsCompletedCount']) || request.resource.data.resultsCompletedCount is int)
            && (!request.resource.data.keys().hasAny(['resultsWithContentCount']) || request.resource.data.resultsWithContentCount is int)
            && (!request.resource.data.keys().hasAny(['artifactsStatus']) || isArtifactsStatusMap(request.resource.data.artifactsStatus));

          // Client updates are limited to "settings-like" fields + archiving.
          allow update: if isOwner(userId)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.projektId == resource.data.projektId
            && request.resource.data.index == resource.data.index
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'instruction', 'name', 'model', 'updatedAt', 'archived', 'archivedAt',
              'promptTemplateId', 'promptPayload', 'autoCombine', 'grundlegendeInformationen', 'ueberschrift', 'thema'
            ])
            && isNonEmptyString(request.resource.data.instruction, 50000)
            && (
              !request.resource.data.keys().hasAny(['name'])
              || request.resource.data.name == resource.data.name
              || isNonEmptyString(request.resource.data.name, 30)
            )
            && isNonEmptyString(request.resource.data.model, 100)
            && isTs(request.resource.data.updatedAt)
            && isValidArchiveState(request.resource.data)
            && request.resource.data.autoCombine is bool;

          allow delete: if false;

          // Results (server-owned; client can only adopt refinement versions).
          match /results/{quelleId} {
            allow read: if isOwner(userId);
            allow create, delete: if false;

            allow update: if isOwner(userId)
              && request.resource.data.keys().hasOnly([
                'quelleId', 'userInput', 'content', 'hasContent', 'model', 'usage', 'costUsd',
                'keySource', 'createdAt', 'updatedAt', 'refinement',
                'status', 'errorMessage', 'errorAt', 'startedAt', 'finishedAt'
              ])
              && request.resource.data.quelleId == quelleId
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.userInput == resource.data.userInput
              && request.resource.data.model == resource.data.model
              && request.resource.data.usage == resource.data.usage
              && request.resource.data.costUsd == resource.data.costUsd
              && request.resource.data.keySource == resource.data.keySource
              && request.resource.data.status == resource.data.status
              && request.resource.data.errorMessage == resource.data.errorMessage
              && request.resource.data.errorAt == resource.data.errorAt
              && request.resource.data.startedAt == resource.data.startedAt
              && request.resource.data.finishedAt == resource.data.finishedAt
              && isUsageMap(request.resource.data.usage)
              && request.resource.data.content is string
              && request.resource.data.content.size() <= 140000
              && request.resource.data.hasContent is bool
              && isTs(request.resource.data.updatedAt)
              && isRefinementMeta(request.resource.data.refinement)
              && resource.data.refinement.rootVersionId == request.resource.data.refinement.rootVersionId
              && resource.data.refinement.maxDepth == request.resource.data.refinement.maxDepth
              && resource.data.refinement.costTotalUsd == request.resource.data.refinement.costTotalUsd
              && resource.data.refinement.initializedAt == request.resource.data.refinement.initializedAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'hasContent', 'updatedAt', 'refinement']);

            match /versions/{versionId} {
              allow read: if isOwner(userId);
              allow write: if false;
            }
          }

          // Artifacts (server-owned; client can only adopt refinement versions).
          match /artifacts/{artifactId} {
            allow read: if isOwner(userId) && isValidArtifactId(artifactId);
            allow create, delete: if false;

            allow update: if isOwner(userId)
              && isValidArtifactId(artifactId)
              && request.resource.data.keys().hasOnly([
                'artifactId', 'content', 'model', 'usage', 'costUsd', 'keySource', 'createdAt', 'updatedAt', 'refinement',
                'heading', 'topic', 'sourceQuelleIds',
                'originalLength', 'shortenedLength', 'compressionRatio', 'usedKapitelIds', 'explanation',
                'aufgabenstellung', 'leseflussLength',
                'status', 'errorMessage', 'errorAt', 'startedAt', 'finishedAt'
              ])
              && request.resource.data.artifactId == artifactId
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.model == resource.data.model
              && request.resource.data.usage == resource.data.usage
              && request.resource.data.costUsd == resource.data.costUsd
              && request.resource.data.keySource == resource.data.keySource
              && request.resource.data.status == resource.data.status
              && request.resource.data.errorMessage == resource.data.errorMessage
              && request.resource.data.errorAt == resource.data.errorAt
              && request.resource.data.startedAt == resource.data.startedAt
              && request.resource.data.finishedAt == resource.data.finishedAt
              && isUsageMap(request.resource.data.usage)
              && request.resource.data.content is string
              && request.resource.data.content.size() <= 140000
              && isTs(request.resource.data.updatedAt)
              && isRefinementMeta(request.resource.data.refinement)
              && resource.data.refinement.rootVersionId == request.resource.data.refinement.rootVersionId
              && resource.data.refinement.maxDepth == request.resource.data.refinement.maxDepth
              && resource.data.refinement.costTotalUsd == request.resource.data.refinement.costTotalUsd
              && resource.data.refinement.initializedAt == request.resource.data.refinement.initializedAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt', 'refinement']);

            match /versions/{versionId} {
              allow read: if isOwner(userId);
              allow write: if false;
            }

            match /groups/{groupId} {
              allow read: if isOwner(userId) && artifactId == 'combined';
              allow write: if false;
            }
          }

          // Summaries are server-only writes.
          match /summaries/{summaryId} {
            allow read: if isOwner(userId);
            allow write: if false;
          }
        }
      }
    }

    // ---------------------------------------------------------------------
    // Stripe (Firebase Extension: firestore-stripe-payments)
    // ---------------------------------------------------------------------

    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }

      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
