rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidPromptStage(stage) {
      return stage in ['process_quelle', 'combine', 'shorten', 'lesefluss', 'summary'];
    }

    function hasProjekt(userId, projektId) {
      return projektId != null && exists(/databases/$(database)/documents/users/$(userId)/projects/$(projektId));
    }

    // User documents - users can only access their own data
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);

      // Users can create their doc but cannot grant themselves platform access
      allow create: if isAuthenticated()
        && isOwner(userId)
        && (
          !request.resource.data.keys().hasAny(['allowPlatformKey'])
          || request.resource.data.allowPlatformKey == false
        );

      // Users may update their profile but not change allowPlatformKey
      allow update: if isAuthenticated()
        && isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['allowPlatformKey']);

      // Users can delete their profile
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // Secrets subcollection - server only
    match /users/{userId}/secrets/{secretId} {
      allow read, write: if false;
    }

    // Prompt templates per user
    match /users/{userId}/promptTemplates/{templateId} {
      allow read: if isAuthenticated() && isOwner(userId);

      allow create: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.keys().hasAll(['stage', 'name', 'instructions', 'createdAt', 'updatedAt'])
        && isValidPromptStage(request.resource.data.stage);

      allow update: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.stage == resource.data.stage
        && isValidPromptStage(resource.data.stage);

      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // Prompt settings (active template selections) per user
    match /users/{userId}/promptSettings/{settingsId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // Projects collection per user
    match /users/{userId}/projects/{projektId} {
      // Read any project owned by the user
      allow read: if isAuthenticated() && isOwner(userId);

      // Create requires ownership + required fields
      allow create: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == userId;

      // Updates/deletes limited to owner
      allow update, delete: if isAuthenticated() && isOwner(userId);
    }

    // Quellen subcollection - under each user document
    match /users/{userId}/quellen/{quelleId} {
      allow read: if isAuthenticated() && isOwner(userId);

      // Create Quelle
      allow create: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.keys().hasAll(['title', 'content', 'projektId', 'createdAt']);

      // Update/delete Quelle
      allow update, delete: if isAuthenticated()
        && isOwner(userId);
    }

    // Kapitels subcollection
    match /users/{userId}/kapitels/{kapitelId} {
      allow read: if isAuthenticated() && isOwner(userId);

      // Create Kapitel with title + quelleIds + createdAt + projektId
      allow create: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.keys().hasAll(['title', 'quelleIds', 'projektId', 'createdAt']);

      allow update, delete: if isAuthenticated()
        && isOwner(userId);

      // Runs under each Kapitel
      match /runs/{runId} {
        allow read: if isAuthenticated() && isOwner(userId);

        // Create run with required fields
        allow create: if isAuthenticated()
          && isOwner(userId)
          && request.resource.data.keys().hasAll(['instruction', 'model', 'index', 'projektId', 'createdAt']);

        allow update, delete: if isAuthenticated() && isOwner(userId);

        // Results under each run
        match /results/{resultId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId);
        }

        // Combined results under each run
        match /combined/{combinedId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId);
          allow update, delete: if isAuthenticated() && isOwner(userId);

          // Text refinement flow (versions/branches) for a combined text
          match /versions/{versionId} {
            allow read: if isAuthenticated() && isOwner(userId);
            // Backend-only writes (FastAPI uses Admin SDK)
            allow write: if false;
          }
        }

        // Intermediate groups under each run
        match /intermediate_groups/{groupId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId);
          allow update, delete: if isAuthenticated() && isOwner(userId);
        }

        // Shortened results under each run
        match /shortened/{shortenedId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId);
          allow update, delete: if isAuthenticated() && isOwner(userId);

          // Text refinement flow (versions/branches) for a shortened text
          match /versions/{versionId} {
            allow read: if isAuthenticated() && isOwner(userId);
            // Backend-only writes (FastAPI uses Admin SDK)
            allow write: if false;
          }
        }

        // Summaries under each run
        match /summaries/{summaryId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId);
          allow update, delete: if isAuthenticated() && isOwner(userId);
        }

        // Lesefluss results under each run
        match /lesefluss/{leseflussId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId);
          allow update, delete: if isAuthenticated() && isOwner(userId);
        }
      }
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
