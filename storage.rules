rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasFullAccess() {
      return request.auth != null
        && (request.auth.token.fullAccess == true);
    }

    function isNotBlocked() {
      // Storage rules cannot read Firestore; rely on the `blocked` claim (stale tokens up to ~1h are acceptable).
      // IMPORTANT: In Storage rules, reading a missing token field can throw (and deny the request).
      // Use `get(.., ..)` so users without the claim are treated as "not blocked".
      return request.auth != null && request.auth.token.get('blocked', false) != true;
    }

    // User-scoped image access for Quellen
    match /users/{userId}/quellen/{quelleId}/{imageName} {
      // Allow authenticated users to read their own images
      allow read: if request.auth != null && request.auth.uid == userId && hasFullAccess() && isNotBlocked();

      // Allow authenticated users to upload their own images
      // NOTE: `request.resource.contentType` appears unreliable for some clients (resulting in false denies).
      // Use filename extension checks as a baseline; enforce stricter checks server-side if needed.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && hasFullAccess()
                   && isNotBlocked()
                   && request.resource.size < 5 * 1024 * 1024  // 5MB limit
                   && imageName.matches('.*\\.(jpg|jpeg|png|webp|gif)$');

      // Allow deletion by owner
      allow delete: if request.auth != null && request.auth.uid == userId && hasFullAccess() && isNotBlocked();
    }

    // User-scoped DOCX exports
    match /users/{userId}/exports/{exportId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId && hasFullAccess() && isNotBlocked();
      allow delete: if request.auth != null && request.auth.uid == userId && hasFullAccess() && isNotBlocked();
    }
  }
}
